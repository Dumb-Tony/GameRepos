  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd85dc200f82a744aa782d995558fdc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Tidebound.Runtime::Tidebound.LoreStone
  interactRadius: 4
  displayName: The rim path
  optionLabel: Look down into the wound
  optionSub: "Two miles across, ringed in shattered crown-rock \u2014 and green."
  flag: CALDERA_SEEN
  prose: "Not jungle-green: GARDEN-green. Terraces, orchards, roofs of woven living
    trees, threads of smoke rising straight in the sheltered air, water gleaming
    in channels that run \u2014 you follow them with your eye and your breath goes
    \u2014 in spirals. A living town, in the wound of the mountain, invisible to
    every chart and every year of the world since the seventeenth century. They went
    in. They stayed in."
  depthRoute: 3
