--- !u!114 &652685685
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 652685683}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd85dc200f82a744aa782d995558fdc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Tidebound.Runtime::Tidebound.LoreStone
  interactRadius: 3.4
  displayName: The mural wall
  optionLabel: Follow the procession
  optionSub: Boats, fields, the mountain breaking, the survivors walking into stone.
  flag: TIDEWELL_MURALS
  prose: "Generation after generation at this pool, and always one figure alone at
    the water's edge in a marked hood: a keeper. The covenant, kept in unbroken sequence
    \u2014 right up to a final panel where the hooded figure stands facing OUT of
    the wall, hand extended. At you. The way every mural tradition ends when it hasn't
    ended."
  depthRoute: 2
