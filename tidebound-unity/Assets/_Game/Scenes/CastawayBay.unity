  m_Script: {fileID: 11500000, guid: 0fd85dc200f82a744aa782d995558fdc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Tidebound.Runtime::Tidebound.LoreStone
  interactRadius: 3
  displayName: A mossed standing stone
  optionLabel: Peel the moss back
  optionSub: Earth on this island has a habit of holding things.
  flag: GLYPH_1
  prose: 'Under the moss, cut faces: spirals and tide-lines, worked once by hands.
    The strokes run seven to a row. You trace one, and the jungle seems, briefly,
    to listen.'
  depthRoute: 1
